rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /groups/{group}/items/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'qty', 'cat', 'by', 'done', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    match /groups/{group}/users/{user} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['avatar'])
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() < 60000;
    }

    match /groups/{group}/weeks/{week} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['votes']);
    }
  }
}
